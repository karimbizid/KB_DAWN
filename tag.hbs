{{!< default}}
{{#contentFor "head"}}
<style>
    :root {
        {{#match @custom.homepage_card_size "Compact"}}
        --home-card-img-w: 80px;  --home-card-img-h: 65px;
        --home-card-pad: 0.9rem;
        {{else match @custom.homepage_card_size "Large"}}
        --home-card-img-w: 120px; --home-card-img-h: 72px;
        --home-card-pad: 2.2rem;
        {{else}}
        --home-card-img-w: 120px; --home-card-img-h: 72px;
        --home-card-pad: 1.4rem;
        {{/match}}
    }
    .tag-section { margin-bottom: 5rem; }
    .tag-section-title { margin-bottom: 1.5rem; }
    .tag-card-feed { max-width: 780px; }

    /* ── Sub-tag filter bar ── */
    .tag-filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        margin-bottom: 2rem;
        max-width: 780px;
    }
    .tag-filter-chip {
        display: inline-block;
        padding: 0;
        border: none;
        background: transparent;
        font-size: 1.6rem;
        font-weight: 400;
        color: var(--brand-color);
        cursor: pointer;
        line-height: 1;
        font-family: var(--gh-font-body, var(--font-sans));
        transition: opacity 0.15s;
    }
    .tag-filter-chip:hover {
        opacity: 0.65;
    }
    .tag-filter-chip.is-active {
        font-weight: 800;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .tag-post-item.is-hidden {
        display: none;
    }
    .tag-filter-no-results {
        display: none;
        color: var(--secondary-text-color);
        font-size: 1.4rem;
        padding: 2rem 0;
        max-width: 780px;
    }
    .tag-filter-no-results.is-visible {
        display: block;
    }

    /* Card tags row */
    .home-card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; }
    .home-card-tag  { font-size: 1rem; font-weight: 400; color: var(--brand-color); white-space: nowrap; line-height: 1; }
</style>
{{/contentFor}}

<main class="site-main">

{{#tag}}

    <section class="tag">
        <div class="gh-canvas">

            <h1 class="tag-name">{{name}}</h1>

            {{#if description}}
                <div class="tag-description">{{description}}</div>
            {{/if}}

            {{#if feature_image}}
                <div class="tag-media u-placeholder horizontal kg-width-wide">
                    <img class="u-object-fit" srcset="{{> srcset}}" src="{{img_url feature_image size="l"}}" alt="{{name}}">
                </div>
            {{/if}}

        </div>
    </section>

    {{! Algemeen — pages tagged with this category, always visible }}
    {{#get "pages" filter="tag:{{slug}}" order="published_at desc" limit="all"}}
        {{#if pages}}
        <div class="tag-section gh-canvas">
            <h2 class="home-category-title tag-section-title">Algemeen</h2>
            <div class="tag-card-feed">
                {{#foreach pages}}
                    {{> "loop-home"}}
                {{/foreach}}
            </div>
        </div>
        {{/if}}
    {{/get}}

    {{! Alle posts — with sub-tag filter bar }}
    <div class="tag-section gh-canvas">
        <h2 class="home-category-title tag-section-title">Alle posts</h2>

        {{! Filter chips are injected by JS; data-prefix tells JS which prefix to strip }}
        <div class="tag-filter-bar" id="tag-filter-bar" data-prefix="{{slug}}-"></div>

        {{#get "posts" filter="tag:{{slug}}" limit="all" order="published_at desc" include="tags"}}
        <div class="tag-card-feed" id="tag-posts-feed">
            {{#foreach posts}}
            <div class="tag-post-item">
                {{! Hidden span carries tag slugs — block helpers inside attr values are unreliable }}
                <span class="js-post-tags" hidden>{{#foreach tags}}{{slug}}|{{/foreach}}</span>
                {{> "loop-home"}}
            </div>
            {{/foreach}}
        </div>
        <p class="tag-filter-no-results" id="tag-no-results">Geen artikelen gevonden voor deze selectie.</p>
        {{/get}}
    </div>

{{/tag}}

</main>

<script>
(function () {
    'use strict';

    var filterBar = document.getElementById('tag-filter-bar');
    if (!filterBar) return;

    var prefix    = filterBar.dataset.prefix || '';         // e.g. "technology-"
    var feed      = document.getElementById('tag-posts-feed');
    var noResults = document.getElementById('tag-no-results');
    if (!feed) return;

    var items = Array.prototype.slice.call(
        feed.querySelectorAll('.tag-post-item')
    );

    // ── Collect unique sub-tags from hidden spans inside each post ───────
    var subTagMap = {};   // { slug: displayLabel }
    items.forEach(function (item) {
        var span = item.querySelector('.js-post-tags');
        if (!span) return;
        var raw = span.textContent.trim().split('|').filter(Boolean);
        raw.forEach(function (tag) {
            tag = tag.trim();
            if (tag && tag.indexOf(prefix) === 0 && !subTagMap[tag]) {
                subTagMap[tag] = '#' + tag.slice(prefix.length);
            }
        });
    });

    var subTagSlugs = Object.keys(subTagMap);
    if (subTagSlugs.length === 0) return;  // No sub-tags — keep bar hidden

    // ── Build filter chips ───────────────────────────────────────────────
    var activeFilters = {};   // { slug: true }

    subTagSlugs.forEach(function (slug) {
        var chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'tag-filter-chip';
        chip.dataset.tag = slug;
        chip.textContent = subTagMap[slug];

        chip.addEventListener('click', function () {
            if (activeFilters[slug]) {
                delete activeFilters[slug];
                chip.classList.remove('is-active');
            } else {
                activeFilters[slug] = true;
                chip.classList.add('is-active');
            }
            applyFilters();
        });

        filterBar.appendChild(chip);
    });

    // ── Filter logic ─────────────────────────────────────────────────────
    function applyFilters() {
        var active  = Object.keys(activeFilters);
        var visible = 0;

        items.forEach(function (item) {
            if (active.length === 0) {
                item.classList.remove('is-hidden');
                visible++;
                return;
            }
            var span  = item.querySelector('.js-post-tags');
            var tags  = span ? span.textContent.trim().split('|').filter(Boolean) : [];
            // OR logic: visible if post has ANY of the selected sub-tags
            var match = active.some(function (f) {
                return tags.indexOf(f) !== -1;
            });
            if (match) {
                item.classList.remove('is-hidden');
                visible++;
            } else {
                item.classList.add('is-hidden');
            }
        });

        if (noResults) {
            if (visible === 0 && active.length > 0) {
                noResults.classList.add('is-visible');
            } else {
                noResults.classList.remove('is-visible');
            }
        }
    }
}());
</script>
