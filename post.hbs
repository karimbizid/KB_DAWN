{{!< default}}
{{#contentFor "head"}}
<style>
    .single-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 0.8rem;
    }
    .single-tags .home-card-tag {
        font-size: 1rem;
        font-weight: 400;
        color: var(--brand-color);
        line-height: 1;
    }
</style>
{{/contentFor}}

<main class="site-main">

    {{#post}}
        {{> "content" width="wide"}}
    {{/post}}

    {{#if @custom.show_related_posts}}
        {{> "related-posts"}}
    {{/if}}

    {{#post}}
        {{> "comments"}}
    {{/post}}

</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var tagEls = Array.prototype.slice.call(
        document.querySelectorAll('.single-tags .home-card-tag')
    );
    if (!tagEls.length) return;

    // Strategy 1: derive prefix from the primary-tag link already on the page
    // e.g. <a href="/tag/technology"> → prefix "technology-"
    var knownPrefixes = [];
    var primaryTagLink = document.querySelector('.single-meta-tag a');
    if (primaryTagLink) {
        var href = primaryTagLink.getAttribute('href').replace(/\/$/, '');
        var catSlug = href.split('/').pop();
        if (catSlug) knownPrefixes.push(catSlug + '-');
    }

    // Strategy 2: also derive prefixes from the slugs of the tags themselves
    var slugs = tagEls.map(function (el) { return (el.dataset.slug || '').toLowerCase(); });
    slugs.forEach(function (s) { if (s) knownPrefixes.push(s + '-'); });

    // Strip the first matching prefix from each sub-tag
    tagEls.forEach(function (el) {
        var slug = (el.dataset.slug || el.textContent.replace(/^#/, '')).toLowerCase();
        for (var i = 0; i < knownPrefixes.length; i++) {
            var prefix = knownPrefixes[i];
            if (slug !== prefix.slice(0, -1) && slug.indexOf(prefix) === 0) {
                el.textContent = '#' + slug.slice(prefix.length);
                break;
            }
        }
    });
});
</script>