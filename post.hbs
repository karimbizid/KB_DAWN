{{!< default}}
{{#contentFor "head"}}
<style>
    .single-tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem;
        margin-bottom: 1rem;
    }
    .single-tags .home-card-tag {
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--brand-color);
        text-transform: uppercase;
        line-height: 1;
    }
</style>
{{/contentFor}}

<main class="site-main">

    {{#post}}
        {{> "content" width="wide"}}
    {{/post}}

    {{#if @custom.show_related_posts}}
        {{> "related-posts"}}
    {{/if}}

    {{#post}}
        {{> "comments"}}
    {{/post}}

</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // ── Tag label prefix stripping ──────────────────────────────────────────
    var tagEls = Array.prototype.slice.call(
        document.querySelectorAll('.single-tags .home-card-tag')
    );
    if (tagEls.length) {
        var slugs = tagEls.map(function (el) {
            return el.getAttribute('data-slug') || '';
        });
        tagEls.forEach(function (el, idx) {
            var slug = slugs[idx];
            for (var i = 0; i < slugs.length; i++) {
                if (i === idx) continue;
                var prefix = slugs[i] + '-';
                if (slug.indexOf(prefix) === 0) {
                    var remainder = slug.slice(prefix.length);
                    el.textContent = '#' + remainder.charAt(0).toUpperCase() + remainder.slice(1);
                    break;
                }
            }
        });
    }
});
</script>

{{> "toc"}}