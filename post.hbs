{{!< default}}
{{#contentFor "head"}}
<style>
    .single-tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem;
        margin-bottom: 1rem;
    }
    .single-tags .home-card-tag {
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--brand-color);
        text-transform: uppercase;
        line-height: 1;
    }
</style>
{{/contentFor}}

<main class="site-main">

    {{#post}}
        {{> "content" width="wide"}}
    {{/post}}

    {{#if @custom.show_related_posts}}
        {{> "related-posts"}}
    {{/if}}

    {{#post}}
        {{> "comments"}}
    {{/post}}

</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var tagEls = Array.prototype.slice.call(
        document.querySelectorAll('.single-tags .home-card-tag')
    );
    if (!tagEls.length) return;

    // Read displayed tag texts (strip leading #, lowercase for comparison)
    var tagTexts = tagEls.map(function (el) {
        return el.textContent.replace(/^#/, '').toLowerCase();
    });

    // For each tag: if its text starts with another tag's text + '-', strip that prefix
    // e.g. tags = ['technology', 'technology-linux'] → 'technology-linux' becomes 'linux'
    tagEls.forEach(function (el, idx) {
        var text = tagTexts[idx];
        for (var i = 0; i < tagTexts.length; i++) {
            if (i === idx) continue;
            var prefix = tagTexts[i] + '-';
            if (text.indexOf(prefix) === 0) {
                el.textContent = '#' + text.slice(prefix.length);
                break;
            }
        }
    });
});
</script>