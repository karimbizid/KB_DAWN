{{!< default}}

<main class="site-main home-template">

    {{#post}}
        {{#if feature_image}}
        <figure class="home-hero">
            <img
                srcset="{{> srcset}}"
                sizes="100vw"
                src="{{img_url feature_image size="xxl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            >
        </figure>
        {{/if}}

        {{#if html}}
        <div class="home-intro gh-canvas">
            {{content}}
        </div>
        {{/if}}
    {{/post}}

    <section class="home-categories gh-canvas">
        <div class="home-categories-grid">

            {{#get "posts" filter="tag:audio" limit="5"}}
            <div class="home-category-col">
                <h2 class="home-category-title"><a href="/tag/audio">Audio</a></h2>
                {{#foreach posts}}
                    {{> "loop"}}
                {{/foreach}}
            </div>
            {{/get}}

            {{#get "posts" filter="tag:music" limit="5"}}
            <div class="home-category-col">
                <h2 class="home-category-title"><a href="/tag/music">Music</a></h2>
                {{#foreach posts}}
                    {{> "loop"}}
                {{/foreach}}
            </div>
            {{/get}}

            {{#get "posts" filter="tag:technology" limit="5"}}
            <div class="home-category-col">
                <h2 class="home-category-title"><a href="/tag/technology">Technology</a></h2>
                {{#foreach posts}}
                    {{> "loop"}}
                {{/foreach}}
            </div>
            {{/get}}

            {{#get "posts" filter="tag:flightsim" limit="5"}}
            <div class="home-category-col">
                <h2 class="home-category-title"><a href="/tag/flightsim">Flightsim</a></h2>
                {{#foreach posts}}
                    {{> "loop"}}
                {{/foreach}}
            </div>
            {{/get}}

        </div>
    </section>

</main>
