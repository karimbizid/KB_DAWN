{{!< default}}
{{#contentFor "body_class"}} has-custom-home{{/contentFor}}
{{#contentFor "head"}}
<style>
    :root {
        {{#match @custom.homepage_card_size "Compact"}}
        --home-card-img-w: 80px;  --home-card-img-h: 65px;
        --home-card-pad: 0.9rem;  --home-grid-max: 1400px;
        {{else match @custom.homepage_card_size "Large"}}
        --home-card-img-w: 120px; --home-card-img-h: 72px;
        --home-card-pad: 2.2rem;  --home-grid-max: 1650px;
        {{else}}
        --home-card-img-w: 120px; --home-card-img-h: 72px;
        --home-card-pad: 1.4rem;  --home-grid-max: 1400px;
        {{/match}}
    }
</style>
{{/contentFor}}

<main class="site-main home-template">

    {{#if @custom.homepage_hero}}
    <figure class="home-hero">
        <img src="{{img_url @custom.homepage_hero size="xxl"}}" alt="{{@site.title}}">
    </figure>
    {{else if @site.cover_image}}
    <figure class="home-hero">
        <img src="{{img_url @site.cover_image size="xxl"}}" alt="{{@site.title}}">
    </figure>
    {{/if}}

    {{#if @custom.homepage_intro}}
    <div class="home-intro gh-canvas">
        <p>{{@custom.homepage_intro}}</p>
        {{#if @custom.homepage_intro_2}}<p>{{@custom.homepage_intro_2}}</p>{{/if}}
        {{#if @custom.homepage_intro_3}}<p>{{@custom.homepage_intro_3}}</p>{{/if}}
    </div>
    {{else if @site.description}}
    <div class="home-intro gh-canvas">
        <p>{{@site.description}}</p>
    </div>
    {{/if}}

    <section class="home-categories">
        <div class="home-categories-inner">
        <div class="home-categories-grid">

            {{#get "posts" filter="tag:audio" limit="5"}}
            <div class="home-category-col">
                <h2 class="home-category-title"><a href="/tag/audio">Audio</a></h2>
                {{#foreach posts}}
                    {{> "loop-home"}}
                {{/foreach}}
            </div>
            {{/get}}

            {{#get "posts" filter="tag:music" limit="5"}}
            <div class="home-category-col">
                <h2 class="home-category-title"><a href="/tag/music">Music</a></h2>
                {{#foreach posts}}
                    {{> "loop-home"}}
                {{/foreach}}
            </div>
            {{/get}}

            {{#get "posts" filter="tag:technology" limit="5"}}
            <div class="home-category-col">
                <h2 class="home-category-title"><a href="/tag/technology">Technology</a></h2>
                {{#foreach posts}}
                    {{> "loop-home"}}
                {{/foreach}}
            </div>
            {{/get}}

            {{#get "posts" filter="tag:flightsim" limit="5"}}
            <div class="home-category-col">
                <h2 class="home-category-title"><a href="/tag/flightsim">Flightsim</a></h2>
                {{#foreach posts}}
                    {{> "loop-home"}}
                {{/foreach}}
            </div>
            {{/get}}

        </div>
        </div>
    </section>

</main>
